---
import Layout from '../layouts/Layout.astro';
import GraphAnalyzer from '../components/GraphAnalyzer.tsx';
---

<Layout title="DeepGraph AI | Zero-Trust Knowledge Extractor">
	<main class="container mx-auto px-4 py-12 max-w-5xl">
		<header class="text-center mb-10">
			<div class="inline-flex items-center justify-center p-3 bg-indigo-100 rounded-xl mb-6 shadow-sm">
				<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
			</div>
			<h1 class="text-5xl font-black text-slate-900 mb-4 tracking-tighter">Deep<span class="text-indigo-600">Graph</span> AI</h1>
			<p class="text-xl text-slate-600 max-w-2xl mx-auto font-medium">
				Extract zero-trust Knowledge Graphs from raw text in milliseconds. 
				Powered by <span class="font-bold text-orange-500">Cloudflare AI</span> and secured by <span class="font-bold text-green-600">AWS Cedar</span>.
			</p>
		</header>

		<div class="bg-white p-2 md:p-8 rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-200">
			<GraphAnalyzer client:only="react" />
		</div>

		<footer class="mt-20 text-center text-sm text-slate-500 font-medium">
			Built for the First Commit Hackathon 2026
		</footer>
	</main>
</Layout>
