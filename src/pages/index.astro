---
import Layout from '../layouts/Layout.astro';
import GraphAnalyzer from '../components/GraphAnalyzer.tsx';
---

<Layout title="DeepGraph AI | Zero-Trust Knowledge Extractor">
	<main class="container mx-auto px-4 py-12 max-w-5xl">
		<header class="text-center mb-10">
			<div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-indigo-100 mb-6 shadow-inner">
				<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600">
					<circle cx="18" cy="5" r="3" />
					<circle cx="6" cy="12" r="3" />
					<circle cx="18" cy="19" r="3" />
					<line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
					<line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
				</svg>
			</div>
			<h1 class="text-5xl font-black text-slate-900 mb-4 tracking-tighter">Deep<span class="text-indigo-600">Graph</span> AI</h1>
			<p class="text-slate-600 max-w-2xl mx-auto text-lg">
				Paste any dense text—articles, contracts, or research—and instantly visualize the key entities and their exact relationships.
			</p>
		</header>

		<div class="bg-white p-2 md:p-8 rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-200">
			<GraphAnalyzer client:only="react" />
		</div>

		<footer class="mt-20 text-center text-sm text-slate-500 font-medium">
			Built for the First Commit Hackathon 2026
		</footer>
	</main>
</Layout>
